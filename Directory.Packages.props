<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <PropertyGroup>
    <AspNetCore>10.0.8</AspNetCore>
    <DuendeIdentityServer>7.4.7</DuendeIdentityServer>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.99.0" />
    <PackageVersion Include="Duende.IdentityServer" Version="$(DuendeIdentityServer)" />
    <PackageVersion Include="Duende.IdentityServer.Configuration.EntityFramework" Version="$(DuendeIdentityServer)" />
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="$(DuendeIdentityServer)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="$(AspNetCore)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCore)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(AspNetCore)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(AspNetCore)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(AspNetCore)" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="TUnit" Version="0.22.0" />
  </ItemGroup>
</Project>
